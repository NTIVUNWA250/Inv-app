# Copy this file to `.env` and fill in real values.
# These come from your Supabase project: https://app.supabase.com → Project Settings → API

# Public project URL, e.g. https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (publishable) key — safe to use here because every request is still
# executed through a user-scoped client, so Row Level Security applies.
SUPABASE_ANON_KEY=your-anon-key-here

# Service-role (secret) key. OPTIONAL — only needed so admins can create and
# delete user accounts. Bypasses RLS, so keep it server-side only. Find it at
# Dashboard → Project Settings → API → service_role. Leave blank to disable
# user create/delete (the rest of the API works without it).
SUPABASE_SERVICE_ROLE_KEY=

# Port the API listens on (default 4000)
PORT=4000

# Comma-separated list of allowed CORS origins (the web app's URL, etc.).
# Use * to allow any origin (development only).
CORS_ORIGINS=http://localhost:3000
