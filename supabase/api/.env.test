# Test / QA environment overrides.
# Loaded on top of `.env` (shared Supabase URL/keys) when APP_ENV=test.
# Run with:  npm run start:test   (or dev:test)
#
# Uses the isolated `test` schema created by migration 0008 — same Supabase
# project, separate tables. Listens on 4001 so it can run alongside prod (4000).

DB_SCHEMA=test

PORT=4001

# Allow the local test web (3001) + Flutter web (8080) + emulator. * is fine
# locally; tighten if this test API is ever exposed.
CORS_ORIGINS=*
