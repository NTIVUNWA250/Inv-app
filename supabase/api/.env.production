# Production environment overrides.
# Loaded on top of `.env` (shared Supabase URL/keys) when APP_ENV=production.
# Run with:  npm run start:prod   (or dev:prod)

# Real data lives in the public schema.
DB_SCHEMA=public

PORT=4000

# Lock this down to your real prod web origin(s) before exposing the API.
CORS_ORIGINS=*
