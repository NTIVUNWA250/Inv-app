# Copy this file to `.env`. The mobile app talks only to the shared
# inventory-api (supabase/api), never to Supabase directly.
#
# Base URL of the inventory-api:
#   Android emulator -> http://10.0.2.2:<port> (maps to the host's localhost)
#   iOS simulator    -> http://localhost:<port>
#   Physical device  -> http://<your-computer-LAN-ip>:<port>
API_URL=http://10.0.2.2:4000
